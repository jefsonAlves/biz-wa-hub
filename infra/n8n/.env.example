# Images are pinned. Review release notes before changing versions.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.31.7

# Local defaults. Production must use HTTPS and public URLs.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# Generate independent random values; never reuse them.
N8N_ENCRYPTION_KEY=change-me-with-at-least-32-random-characters
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-with-at-least-32-random-characters
N8N_WEBHOOK_SECRET=change-me-with-at-least-32-random-characters
N8N_API_KEY=

DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=change-me-with-a-strong-database-password
DB_POSTGRESDB_SCHEMA=n8n

QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_DB=0
N8N_WORKER_CONCURRENCY=5

GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
N8N_PAYLOAD_SIZE_MAX=16
EXECUTIONS_DATA_MAX_AGE=336

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=
AI_ROUTER_CONFIDENCE_THRESHOLD=0.70
AI_ROUTER_COMPLEXITY_THRESHOLD=0.65
