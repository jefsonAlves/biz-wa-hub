PORT=3001
# Opcional. Se definido, as Edge Functions devem usar o mesmo valor em WHATSAPP_BACKEND_TOKEN.
BACKEND_TOKEN=
# Diretório persistente das sessões. Em produção, aponte para disco persistente.
WHATSAPP_DATA_DIR=./sessions
# Ex.: https://seuapp.lovable.app ou *
ALLOWED_ORIGIN=*
LOG_LEVEL=info
