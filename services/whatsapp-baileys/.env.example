PORT=3001
# Opcional. Se definido, as Edge Functions devem usar o mesmo valor em WHATSAPP_BACKEND_TOKEN.
BACKEND_TOKEN=
# Diretório persistente das sessões. Em produção, aponte para disco persistente.
WHATSAPP_DATA_DIR=./sessions
# Endpoint da Edge Function que recebe mensagens do Baileys e grava no Inbox.
# Ex.: https://SEU-PROJETO.supabase.co/functions/v1/whatsapp-baileys-webhook
WHATSAPP_WEBHOOK_URL=
# Timeout do envio de eventos ao Supabase.
WEBHOOK_TIMEOUT_MS=15000
# Ex.: https://seuapp.lovable.app ou *
ALLOWED_ORIGIN=*
LOG_LEVEL=info
